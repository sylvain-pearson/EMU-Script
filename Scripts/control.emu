[composition]
title: "MIDI messages control"
by: "Sylvain Pearson"
time: 4/4
BPM: 100
transposition: 0
playlist: set-once, linear, curved, span

[instruments]
synth: "MIDI Input", channel=4, octave=2, velocity=80, info="Nord Lead A1"
drum: "drum", channel=10, velocity=70

[sequences]
drum-seq: kick kick/hh kick kick/hh
synth-seq: . | 1 1 1 1 1 1 1 5 | * | * | * 

[sounds]
kick: midi(36)
hh: midi(42)
toc: midi(37)

[CC]
synth: cutoff=74, resonance=42
all: modw=1

[control]
/synth/set-once: program=8.8, modw=95%, velocity=90
/synth/set-once/4: modw=15%
/drum/set-once/2: velocity=40
/drum/set-once/2.75: velocity=100

/synth/linear: program=8.14
/synth/linear: change(velocity, from=100, to=10)
/synth/linear: change(cutoff, from=20%, to=50%)
/drum/linear:  change(velocity, from=30, to=100)

/synth/curved: program=8.14
/synth/curved: change(cutoff, from=0, to=100, curve=1)
/synth/curved: change(resonance, from=120, to=20, curve=-1)

/synth/span: program=8.14
/synth/span/2: change(cutoff, from=40, to=75, span=2)
/synth/span/4: change(cutoff, from=75, to=40, span=2)
/drum/span/1.5: change(velocity, from=75, to=60, span=2.5)

[set-once]
synth: . |  1 1' | 1 3 5 - | 1 1' | 1 3 5 -
drum: drum-seq | ... 

[linear]
synth: synth-seq 
drum: drum-seq | ...

[curved]
synth: synth-seq 
drum: drum-seq | ...

[span]
synth: synth-seq
drum: drum-seq | ...