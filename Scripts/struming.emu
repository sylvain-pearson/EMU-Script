[composition]
title: "Guitar Strumming"
by: "Sylvain Pearson"
time: 4/4
BPM: 120
transposition: -1
playlist: example

[instruments]
guitar: "guitar", channel=4, octave=3, velocity=60

[sounds]
dw: strum(54321, msec=5, vdec=3)
up: strum(12345, msec=6, vdec=5)

[sequences]
r1: dw/chord(5) - - up/chord(3) dw/chord(5) - - -
r2: up/chord(5) - - dw/chord(3) up/chord(5) - - -
r3: dw/chord(5) - - - - - up/chord(3) -

[example]
guitar: r1 | r2 | r1 | r3 | r1 | r2 | r1 | up/chord(5)
chord: 'min(A) | min(D) | maj(G,D) | maj(C) | maj(F) | 'dim(B) | min(E) | 'min(A)
